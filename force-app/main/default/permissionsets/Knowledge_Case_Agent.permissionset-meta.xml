<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Knowledge Case Agent</label>
    <description>Grants support agents access to Salesforce Knowledge and the CaseKnowledgeArticles component so they can view, search, and attach Knowledge articles from the Case detail page.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <userPermissions>
        <enabled>true</enabled>
        <name>KnowledgeUser</name>
    </userPermissions>
    <classAccesses>
        <apexClass>CaseKnowledgeController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>CaseArticle</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
</PermissionSet>
